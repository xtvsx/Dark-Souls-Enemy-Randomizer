<Window x:Class="EnemyRandomizer.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EnemyRandomizer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:DialogViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Grid Margin="24,22,24,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                 VerticalAlignment="Top" Margin="0,0,18,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Kind}" Value="Error">
                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- Long messages (error details) scroll instead of growing past the screen -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                   Background="Transparent" Padding="0" AutomationProperties.Name="{Binding Title}" />
          <TextBlock Margin="0,12,0,0" Visibility="{Binding HasLink, Converter={StaticResource BoolToVisibility}}">
            <Hyperlink Command="{Binding OpenLinkCommand}" Foreground="{DynamicResource AccentBrush}">
              <Run Text="{Binding LinkUrl, Mode=OneWay}" />
            </Hyperlink>
          </TextBlock>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,20,0,0" IsTabStop="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DialogButton}">
          <Button Content="{Binding Label}" IsDefault="{Binding IsDefault}" IsCancel="{Binding IsCancel}"
                  Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                  CommandParameter="{Binding}" MinWidth="88" Margin="8,0,0,0" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</Window>
