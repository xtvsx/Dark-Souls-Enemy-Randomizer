<Window x:Class="EnemyRandomizer.App.Views.BackupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EnemyRandomizer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:BackupsViewModel}"
        Style="{StaticResource AppWindow}"
        Title="Backups" Width="640" Height="520" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBlock Grid.Row="1" Text="{Binding Warning}" TextWrapping="Wrap" Margin="0,0,0,8"
               Foreground="{DynamicResource ErrorBrush}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Style.Triggers>
            <Trigger Property="Text" Value="">
              <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>

    <!-- Restore points: the first one is the initial state of the game, then one per earlier randomization -->
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Items}" IsTabStop="False" AutomationProperties.Name="Backups">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:BackupSetViewModel}">
            <Border Padding="14,12" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Details}" FontSize="12" Margin="0,2,0,0"
                             Foreground="{DynamicResource MutedTextBrush}" />
                  <Border HorizontalAlignment="Left" CornerRadius="3" Padding="8,2" Margin="0,8,0,0"
                          Background="{DynamicResource AccentSoftBrush}"
                          Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Badge}" FontSize="12" Foreground="{DynamicResource TextBrush}" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="Restore" MinWidth="80"
                          Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Restore {0}'}" />
                  <Button Content="Delete" MinWidth="70" Margin="8,0,0,0"
                          Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                          Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat='Delete {0}'}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Left" Content="_Verify" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
              ToolTip="Check all backups again" />
      <Button DockPanel.Dock="Left" Content="_Open backup folder" Command="{Binding OpenFolderCommand}" />
    </DockPanel>
  </Grid>
</Window>
