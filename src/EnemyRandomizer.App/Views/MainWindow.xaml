<Window x:Class="EnemyRandomizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EnemyRandomizer.App.ViewModels"
        xmlns:opt="clr-namespace:EnemyRandomizer.App.ViewModels.Options"
        xmlns:svc="clr-namespace:EnemyRandomizer.App.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource AppWindow}"
        Title="{Binding Title}"
        Icon="/Assets/app.ico"
        Width="900" Height="820" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Option layout: title, control, caption (why it is disabled, otherwise what the current value does).
         Nothing has a fixed width and all text wraps, so nothing is clipped. -->
    <DataTemplate x:Key="RadioOptionTemplate" DataType="{x:Type opt:ChoiceOptionViewModel}">
      <Grid Margin="0,0,0,16" IsEnabled="{Binding IsEnabled}"
            AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />

        <!-- A few choices: radio buttons in a wrapping row -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Choices}" IsTabStop="False">
          <ItemsControl.Style>
            <Style TargetType="ItemsControl">
              <Style.Triggers>
                <DataTrigger Binding="{Binding UseDropdown}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ItemsControl.Style>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type opt:ChoiceViewModel}">
              <RadioButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                           Margin="0,0,20,4" ToolTip="{Binding Description}"
                           AutomationProperties.HelpText="{Binding Description}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Many choices: drop-down -->
        <ComboBox Grid.Row="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding Value, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="260"
                  AutomationProperties.Name="{Binding Title}"
                  Visibility="{Binding UseDropdown, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Grid.Row="2" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </Grid>
    </DataTemplate>

    <!-- Option drawn as selectable cards (the randomize method): equal-width cards in one row -->
    <DataTemplate x:Key="CardOptionTemplate" DataType="{x:Type opt:ChoiceOptionViewModel}">
      <ItemsControl ItemsSource="{Binding Choices}" IsTabStop="False" IsEnabled="{Binding IsEnabled}" Margin="0,0,0,16"
                    AutomationProperties.Name="{Binding Title}"
                    AutomationProperties.HelpText="{Binding Description}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type opt:ChoiceViewModel}">
            <RadioButton Style="{StaticResource CardRadioButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         ToolTip="{Binding Description}"
                         AutomationProperties.Name="{Binding Label}"
                         AutomationProperties.HelpText="{Binding Description}">
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </DataTemplate>

    <!-- Choice option: cards or radio/drop-down depending on its presentation -->
    <DataTemplate DataType="{x:Type opt:ChoiceOptionViewModel}">
      <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RadioOptionTemplate}" IsTabStop="False">
        <ContentControl.Style>
          <Style TargetType="ContentControl">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsCard}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource CardOptionTemplate}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </DataTemplate>

    <!-- Percentage slider option -->
    <DataTemplate DataType="{x:Type opt:SliderOptionViewModel}">
      <Grid Margin="0,0,0,16" IsEnabled="{Binding IsEnabled}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0}%}" FontWeight="SemiBold"
                   Margin="12,0,0,0" TextAlignment="Right" MinWidth="40" />
        <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                Value="{Binding Value, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}" />
        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </Grid>
    </DataTemplate>

    <!-- One category: heading and its shown options; the whole section disappears when the mode hides all of them -->
    <DataTemplate DataType="{x:Type opt:OptionSectionViewModel}">
      <Border Padding="16,14,16,0" Margin="0,0,0,12" CornerRadius="6" Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
              Visibility="{Binding HasVisibleOptions, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                     AutomationProperties.HeadingLevel="Level2" />
          <ItemsControl ItemsSource="{Binding VisibleOptions}" IsTabStop="False" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="R" Modifiers="Ctrl" Command="{Binding RandomizeCommand}" />
    <KeyBinding Key="F1" Command="{Binding ShowAboutCommand}" />
  </Window.InputBindings>

  <Grid>
  <Grid Margin="12">
    <Grid.Style>
      <Style TargetType="Grid">
        <Style.Triggers>
          <!-- While an operation runs the options behind the overlay are not reachable by keyboard either. -->
          <DataTrigger Binding="{Binding IsBusy}" Value="True">
            <Setter Property="IsEnabled" Value="False" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Grid.Style>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top bar: seed + overflow menu -->
    <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
      <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
        <MenuItem AutomationProperties.Name="Menu" ToolTip="Menu (F10)" Padding="10,6">
          <MenuItem.Header>
            <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="18" />
          </MenuItem.Header>
          <MenuItem Header="_Open config input..." Command="{Binding OpenTextConfigCommand}" />
          <MenuItem Header="Copy enemy _placement..." Command="{Binding CopyPlacementCommand}" />
          <MenuItem Header="About copy _info" Command="{Binding ShowCopyInfoCommand}" />
          <Separator />
          <MenuItem Header="_Backups..." Command="{Binding ShowBackupsCommand}" />
          <MenuItem Header="Restore _default settings" Command="{Binding RestoreDefaultsCommand}" />
          <MenuItem Header="Change game _folder..." Command="{Binding ChooseGameFolderCommand}" />
          <MenuItem Header="_Theme">
            <MenuItem Header="Follow _Windows" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.System}" />
            <MenuItem Header="_Light" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Light}" />
            <MenuItem Header="_Dark" Command="{Binding SetThemeCommand}" CommandParameter="{x:Static svc:AppTheme.Dark}" />
          </MenuItem>
          <Separator />
          <MenuItem Header="_About" Command="{Binding ShowAboutCommand}" InputGestureText="F1" />
        </MenuItem>
      </Menu>
      <Label DockPanel.Dock="Left" Content="_Seed (leave blank for random):" Target="{Binding ElementName=SeedBox}"
             VerticalAlignment="Center" Padding="0" Margin="0,0,8,0" />
      <TextBox x:Name="SeedBox" Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}"
               VerticalContentAlignment="Center" MaxWidth="360" HorizontalAlignment="Left" MinWidth="220" />
    </DockPanel>

    <!-- All options on one page, grouped by category -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="780" HorizontalAlignment="Stretch" Margin="0,0,12,0">

        <!-- Startup problems come first: nothing below works until they are fixed -->
        <Border Padding="16" Margin="0,0,0,12" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ErrorBrush}"
                Visibility="{Binding HasStartupErrors, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <TextBlock Text="{Binding StartupErrorsHeader}" TextWrapping="Wrap" FontWeight="SemiBold"
                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,12" />
            <Button Content="Choose game _folder..." Command="{Binding ChooseGameFolderCommand}"
                    HorizontalAlignment="Left" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding StartupErrors}" IsTabStop="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <BulletDecorator Margin="0,0,0,8">
                    <BulletDecorator.Bullet>
                      <TextBlock Text="•" Foreground="{DynamicResource ErrorBrush}" />
                    </BulletDecorator.Bullet>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,0,0,0" />
                  </BulletDecorator>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Sections}" IsTabStop="False" />

        <!-- Enemy config -->
        <Border Padding="16,14,16,16" Margin="0,0,0,12" CornerRadius="6" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock Text="Enemy config" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"
                       AutomationProperties.HeadingLevel="Level2" />
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="Open _editor" Command="{Binding OpenEnemyConfigEditorCommand}" Margin="8,0,0,0" />
              <ComboBox AutomationProperties.Name="Enemy config" ItemsSource="{Binding EnemyConfigNames}"
                        SelectedItem="{Binding SelectedEnemyConfig}" />
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Result banner -->
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="12,8" CornerRadius="4" BorderThickness="1"
            Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}"
            AutomationProperties.LiveSetting="Assertive">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Notice.IsError}" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Copy details" Command="{Binding CopyNoticeDetailsCommand}" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="{Binding Notice.FolderLabel}" Command="{Binding OpenNoticeFolderCommand}" Margin="8,0,0,0"
                Visibility="{Binding Notice.HasFolder, Converter={StaticResource BoolToVisibility}}" />
        <StackPanel>
          <TextBlock Text="{Binding Notice.Title}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Notice.Message}" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Sticky action bar -->
    <Border Grid.Row="3" Margin="0,10,0,0" Padding="0,10,0,0"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="_Randomize" Command="{Binding RandomizeCommand}"
                Style="{StaticResource PrimaryButton}" IsDefault="True" ToolTip="Randomize (Ctrl+R)"
                Margin="8,0,0,0" MinWidth="130" />
        <Button DockPanel.Dock="Right" Content="Re_vert to normal" Command="{Binding RevertCommand}" Margin="8,0,0,0" />
        <Button DockPanel.Dock="Right" Content="_Backups..." Command="{Binding ShowBackupsCommand}" Margin="8,0,0,0"
                ToolTip="Check, verify and restore the backups of the game files" />
        <TextBlock Text="{Binding EditionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MutedTextBrush}" />
      </DockPanel>
    </Border>
  </Grid>

  <!-- Progress overlay -->
  <Grid Visibility="{Binding ActiveProgress, Converter={StaticResource NullToCollapsed}}">
    <Border Background="#99000000" />
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Padding="20"
            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="6" DataContext="{Binding ActiveProgress}">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
        <ProgressBar Height="10" Minimum="0" Maximum="{Binding TotalSteps}" Value="{Binding Step}"
                     IsIndeterminate="{Binding IsIndeterminate}" Foreground="{DynamicResource AccentBrush}"
                     AutomationProperties.Name="Progress" Margin="0,0,0,8" />
        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"
                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
