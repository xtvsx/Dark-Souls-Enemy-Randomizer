<Application x:Class="EnemyRandomizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnemyRandomizer.App.Converters"
             ShutdownMode="OnMainWindowClose"
             ThemeMode="System">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.Light.xaml" />
        <ResourceDictionary Source="Themes/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
      <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
